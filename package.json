{
    "name": "happy-harmony",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev --env staging --port 3000",
        "dev:vite": "vite dev --port 3000",
        "dev:prod": "wrangler dev --port 3000",
        "preview:pr": "pnpm run build && wrangler versions upload --env staging",
        "start": "node .output/server/index.mjs",
        "build": "vite build",
        "serve": "vite preview",
        "test": "VITEST=true vitest run",
        "test:e2e": "pnpm exec playwright test",
        "test:e2e:report": "pnpm exec playwright show-report",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "prepare": "husky",
        "change": "pnpm exec changeset && git add .changeset",
        "change:empty": "pnpm exec changeset add --empty",
        "lint": "pnpm exec eslint --cache --cache-location .eslintcache .",
        "lint:fix": "pnpm exec eslint --cache --cache-location .eslintcache --fix .",
        "lint-staged": "pnpm exec lint-staged",
        "format": "pnpm exec prettier --write .",
        "format:check": "pnpm exec prettier --check .",
        "typecheck": "tsc --noEmit",
        "changeset": "pnpm exec changeset",
        "changeset:status": "pnpm exec changeset status --since=origin/main",
        "changeset:version": "pnpm exec changeset version",
        "changeset:publish": "pnpm exec changeset publish",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
        "clean": "rm -rf .turbo node_modules .wrangler .output dist",
        "deploy": "pnpm run build && wrangler deploy",
        "deploy:staging": "pnpm run build && node scripts/write-staging-wrangler.mjs && wrangler deploy --config dist/server/wrangler.staging.json",
        "preview": "pnpm run build && vite preview",
        "cf-typegen": "wrangler types",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
        "db:seed": "wrangler d1 execute DB --local --file=./drizzle/seeds/seed.sql",
        "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate"
    },
    "dependencies": {
        "@cloudflare/vite-plugin": "^1.20.1",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@sentry/cloudflare": "^10.32.1",
        "@sentry/tanstackstart-react": "^10.32.1",
        "@tanstack/react-devtools": "^0.7.0",
        "@tanstack/react-query": "^5.66.5",
        "@tanstack/react-query-devtools": "^5.84.2",
        "@tanstack/react-router": "^1.132.0",
        "@tanstack/react-router-devtools": "^1.132.0",
        "@tanstack/react-router-ssr-query": "^1.131.7",
        "@tanstack/react-start": "^1.132.0",
        "@tanstack/router-plugin": "^1.132.0",
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.4.10",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.1",
        "eslint": "link:@tanstack/config/eslint",
        "eslint-plugin-react": "^7.37.5",
        "ohash": "^2.0.11",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite-tsconfig-paths": "^5.1.4",
        "zod": "^4.3.5",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@cloudflare/workers-types": "^4.20260109.0",
        "@playwright/test": "^1.57.0",
        "@sentry/vite-plugin": "^4.6.1",
        "@tanstack/eslint-config": "^0.3.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^5.0.4",
        "babel-plugin-react-compiler": "^1.0.0",
        "baseline-browser-mapping": "^2.9.14",
        "drizzle-kit": "^0.31.8",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-typescript-sort-keys": "^3.3.0",
        "eslint-plugin-unused-imports": "^4.2.0",
        "husky": "^9.1.7",
        "jsdom": "^27.0.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.5.3",
        "tsx": "^4.21.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.45.0",
        "vite": "^7.3.1",
        "vitest": "^3.0.5",
        "web-vitals": "^5.1.0",
        "wrangler": "^4.59.2"
    },
    "engines": {
        "node": ">=18.18"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,cts,mts,cjs,mjs}": [
            "pnpm exec eslint --cache --cache-location .eslintcache --fix"
        ],
        "*.{ts,tsx,js,jsx,cts,mts,cjs,mjs,json,md,mdx,yml,yaml,css,scss}": [
            "pnpm exec prettier --cache --write"
        ]
    }
}

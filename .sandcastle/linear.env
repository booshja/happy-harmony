# .sandcastle/linear.env — non-secret Linear routing for the headless sandcastle loop.
# Committed on purpose: this is routing, not secrets. The secret LINEAR_API_KEY
# lives only in the gitignored .sandcastle/.env. See docs/agents/issue-tracker.md.

LINEAR_TEAM_KEY=JANDES                                   # Booshja team; JANDES-### prefix
LINEAR_PROJECT_ID=e083d04b-0285-472e-9316-7115a505d2c3   # project the loop is scoped to
LINEAR_PROJECT_NAME="Happy Harmony"

# Workflow-state UUIDs for close transitions (team JANDES; re-resolve via list_issue_statuses)
LINEAR_DONE_STATE_ID=4e87981d-b4ee-41d0-9a39-4d8fd195789a
LINEAR_CANCELED_STATE_ID=2a2a8875-de26-4db4-a262-b1ee9f4cf353   # for wontfix

# Gate labels the loop honors
LINEAR_READY_LABEL=ready-for-agent
LINEAR_HOLD_LABEL=do-not-proceed
